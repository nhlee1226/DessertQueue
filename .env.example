# ============================================================
# 줄서는디저트 API 키
# 값은 = 뒤에 따옴표 없이 붙여 넣으세요. 이 파일은 깃에 올라가지 않습니다.
# 키를 바꾼 뒤에는 개발 서버를 다시 켜야 반영됩니다.
# ============================================================

# ------------------------------------------------------------
# [필수] 서버 전용 키 (브라우저에 노출되지 않음)
# ------------------------------------------------------------

# 1. 네이버 데이터랩 + 검색 API (블로그·카페)
#    developers.naver.com → Application → 애플리케이션 등록
#    사용 API: "데이터랩(검색어트렌드)", "검색" 체크
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 2. 카카오 로컬 API (매장 검색)
#    developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=

# ------------------------------------------------------------
# [필수] 브라우저용 키 (NEXT_PUBLIC_ 접두사 필수)
# ------------------------------------------------------------

# 3. 카카오맵 JavaScript SDK
#    위와 같은 카카오 앱 → 앱 키 → JavaScript 키
#    플랫폼 → Web → 사이트 도메인에 http://localhost:3000 등록
#    카카오맵 서비스 사용 설정도 켜야 함
NEXT_PUBLIC_KAKAO_JS_KEY=

# ------------------------------------------------------------
# [추천] 실시간 제보 저장 (Supabase)
#    supabase.com → New project → Project Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# [추천] SNS 트렌드 수집
# ------------------------------------------------------------

# 5. Instagram Graph API
#    developers.facebook.com → 앱 생성 → Instagram Graph API
#    인스타 비즈니스/크리에이터 계정 + 페이스북 페이지 연결 필요
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# 6. YouTube Data API v3
#    console.cloud.google.com → API 및 서비스 → YouTube Data API v3 사용 → 사용자 인증 정보 → API 키
YOUTUBE_API_KEY=

# 7. X (트위터) API — 유료, 우선순위 낮음
#    developer.x.com → Project → Bearer Token
X_BEARER_TOKEN=

# ------------------------------------------------------------
# [추천] 줄 줄면 알림 (Web Push)
#    터미널에서 생성: npx web-push generate-vapid-keys
# ------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
